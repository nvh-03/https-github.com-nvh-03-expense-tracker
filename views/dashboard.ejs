<%- include('partials/header', { title: 'Tổng quan' }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 m-0">Tổng quan tháng <%= month.split('-').reverse().join('/') %></h1>
  <a class="btn btn-primary" href="/transactions/new">+ Thêm giao dịch</a>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-4"><div class="card shadow-sm border-success"><div class="card-body">
    <div class="text-muted small">Tổng thu</div>
    <div class="h4 text-success m-0"><%= formatMoney(totals.income) %></div>
  </div></div></div>
  <div class="col-md-4"><div class="card shadow-sm border-danger"><div class="card-body">
    <div class="text-muted small">Tổng chi</div>
    <div class="h4 text-danger m-0"><%= formatMoney(totals.expense) %></div>
  </div></div></div>
  <div class="col-md-4"><div class="card shadow-sm border-primary"><div class="card-body">
    <div class="text-muted small">Số dư</div>
    <div class="h4 m-0 <%= totals.income - totals.expense >= 0 ? 'text-primary' : 'text-danger' %>">
      <%= formatMoney(totals.income - totals.expense) %>
    </div>
  </div></div></div>
</div>

<% if (budgetAlerts.length) { %>
<div class="card shadow-sm border-warning mb-4">
  <div class="card-header fw-semibold">⚠️ Cảnh báo ngân sách</div>
  <ul class="list-group list-group-flush">
    <% budgetAlerts.forEach(b => { %>
      <li class="list-group-item d-flex justify-content-between">
        <span><%= b.name %></span>
        <span class="<%= b.status === 'over' ? 'text-danger fw-semibold' : 'text-warning-emphasis' %>">
          <%= formatMoney(b.spent) %> / <%= formatMoney(b.budget) %> (<%= b.percent %>%)
        </span>
      </li>
    <% }) %>
  </ul>
  <div class="card-footer small"><a href="/budgets">Xem ngân sách →</a></div>
</div>
<% } %>

<div class="card shadow-sm">
  <div class="card-header d-flex justify-content-between">
    <span class="fw-semibold">Giao dịch gần đây</span>
    <a href="/transactions" class="small">Xem tất cả →</a>
  </div>
  <ul class="list-group list-group-flush">
    <% if (recent.length === 0) { %>
      <li class="list-group-item text-muted">Chưa có giao dịch nào. <a href="/transactions/new">Thêm giao dịch đầu tiên</a>.</li>
    <% } %>
    <% recent.forEach(t => { %>
      <li class="list-group-item d-flex justify-content-between">
        <span><span class="text-muted small me-2"><%= formatDate(t.date) %></span><%= t.category_name %>
          <% if (t.note) { %><span class="text-muted small">· <%= t.note %></span><% } %></span>
        <span class="fw-semibold <%= t.type === 'income' ? 'text-success' : 'text-danger' %>">
          <%= t.type === 'income' ? '+' : '−' %><%= formatMoney(t.amount) %>
        </span>
      </li>
    <% }) %>
  </ul>
</div>
<%- include('partials/footer') %>
