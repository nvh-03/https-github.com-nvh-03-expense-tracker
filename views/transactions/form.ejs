<%- include('../partials/header', { title }) %>
<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h1 class="h4 mb-3"><%= title %></h1>

        <% if (errors.length) { %>
          <div class="alert alert-danger"><ul class="mb-0">
            <% errors.forEach(e => { %><li><%= e %></li><% }) %>
          </ul></div>
        <% } %>

        <form method="POST" action="<%= action %>">
          <div class="mb-3">
            <label class="form-label">Danh mục</label>
            <select class="form-select" name="category_id" required>
              <option value="">-- Chọn danh mục --</option>
              <%# optgroup chia danh mục thành 2 nhóm Thu / Chi %>
              <% [['income', 'Thu nhập'], ['expense', 'Chi tiêu']].forEach(([type, label]) => { %>
                <optgroup label="<%= label %>">
                  <% categories.filter(c => c.type === type).forEach(c => { %>
                    <option value="<%= c.id %>" <%= String(tx.category_id) === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
                  <% }) %>
                </optgroup>
              <% }) %>
            </select>
            <div class="form-text">Chưa có danh mục phù hợp? <a href="/categories">Thêm danh mục</a></div>
          </div>
          <div class="mb-3">
            <label class="form-label">Số tiền (₫)</label>
            <input class="form-control" name="amount" inputmode="numeric" placeholder="VD: 50000"
                   value="<%= tx.amount || '' %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Ngày</label>
            <input class="form-control" type="date" name="date" value="<%= tx.date || '' %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Ghi chú</label>
            <input class="form-control" name="note" maxlength="200" placeholder="VD: Ăn trưa với bạn"
                   value="<%= tx.note || '' %>">
          </div>
          <div class="d-flex gap-2">
            <button class="btn btn-primary">Lưu</button>
            <a class="btn btn-outline-secondary" href="/transactions">Huỷ</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
