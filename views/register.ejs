<%- include('partials/header', { title: 'Đăng ký' }) %>
<div class="row justify-content-center">
  <div class="col-md-5">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h1 class="h4 mb-3">Tạo tài khoản</h1>
        <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
        <form method="POST" action="/register">
          <div class="mb-3">
            <label class="form-label">Họ tên</label>
            <input class="form-control" name="name" value="<%= form.name || '' %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input class="form-control" type="email" name="email" value="<%= form.email || '' %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Mật khẩu (ít nhất 6 ký tự)</label>
            <input class="form-control" type="password" name="password" minlength="6" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Nhập lại mật khẩu</label>
            <input class="form-control" type="password" name="confirm" minlength="6" required>
          </div>
          <button class="btn btn-primary w-100">Đăng ký</button>
        </form>
        <p class="mt-3 mb-0 text-center small">Đã có tài khoản? <a href="/login">Đăng nhập</a></p>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
